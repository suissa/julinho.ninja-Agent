# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# RabbitMQ Connection Settings
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_TIMEOUT=10000
RABBITMQ_RECONNECT_DELAY=5000
RABBITMQ_MAX_RECONNECT_ATTEMPTS=10
RABBITMQ_PREFETCH_COUNT=1

# System Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
METRICS_PORT=9090

# Chatbot Configuration
MIN_MESSAGE_INTERVAL=2000
SESSION_TIMEOUT=1800000
MAX_RETRY_ATTEMPTS=3
MAX_CONCURRENT_SESSIONS=1000
MESSAGE_PROCESSING_TIMEOUT=5000
QUEUE_PROCESSING_BATCH_SIZE=10

# Session Persistence Configuration
SESSION_PERSISTENCE_ENABLED=true
SESSION_STORAGE_PATH=./sessions
SESSION_CLEANUP_INTERVAL=300000
SESSION_TIMEOUT=1800000

# Agent Configuration
AGENT_TIMEOUT_USER_RESPONSE=30000
AGENT_TIMEOUT_REMINDER=60000
AGENT_MAX_RETRIES=3

# WhatsApp Configuration
WHATSAPP_SERVICE_URL=http://localhost:3000
WHATSAPP_API_KEY=your-api-key-here

# Security Configuration
ENCRYPT_SENSITIVE_DATA=true
DATA_RETENTION_DAYS=30
AUDIT_LOGGING=true

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=./logs/chatbot.log
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_FILES=5
SANITIZE_USER_DATA=true

# Monitoring Configuration
MONITORING_ENABLED=true
HEALTH_CHECK_PORT=8080
HEALTH_CHECK_PATH=/health

# Docker Configuration
DOCKER_RABBITMQ_PORT=5672
DOCKER_RABBITMQ_MANAGEMENT_PORT=15672

# Performance Configuration
MEMORY_LIMIT=512M
CPU_LIMIT=0.5